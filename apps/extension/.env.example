# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings → API). Without them the extension works fully, but the
# "Sign in with Google" button is disabled. See docs/SETUP.md.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (starts with sb_publishable_) or the legacy anon key.
# It is safe to ship in the extension; access is controlled by Row Level Security.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
